{
    "save_dir": "checkpoints/finetune_5k",
    "model": {
        "net": "b2scvr_hq",
        "no_dis": true,
        "pretrain": "checkpoints/B2SCVR_ckpts/B2SCVR.pth"
    },
    "trainer": {
        "iterations": 25000,
        "batch_size": 1,
        "num_workers": 4,
        "lr": 1e-5,
        "beta1": 0.9,
        "beta2": 0.999,
        "spynet_lr": 1.0,
        "save_freq": 1000,
        "log_freq": 50,
        "scheduler": {
            "type": "MultiStepRestartLR",
            "milestones": [10000],
            "gamma": 0.5
        }
    },
    "losses": {
        "GAN_LOSS": "hinge",
        "adversarial_weight": 0.0,
        "hole_weight": 1.0,
        "valid_weight": 0.05,
        "boundary_weight": 0.0
    },
    "train_data_loader": {
        "format": "dir",
        "gt_root":   "/home/ajeet/MINIP/data/train/train_gt_imgs",
        "bsc_root":  "/home/ajeet/MINIP/data/train/train_bsc_imgs",
        "mask_root": "/home/ajeet/MINIP/data/train/train_masks",
        "num_local_frames": 5,
        "num_ref_frames": 3,
        "w": 432,
        "h": 240
    }
}
